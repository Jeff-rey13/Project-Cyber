# copy to .env and fill in; never commit .env
# both secrets must be >= 16 chars and not start with "change-me" or the control plane refuses to start
AEROSCAN_OPERATOR_TOKEN=change-me
AEROSCAN_SNAPSHOT_KEY=change-me
DATABASE_URL=sqlite:///./aeroscan.db
REDIS_URL=redis://redis:6379/0
NIMBUS_SECURE_MODE=false
NIMBUS_SEED=1337
ZAP_API_KEY=change-me
